# ── Database ──
DATABASE_URL=postgresql://user:password@host:5432/db

# ── Auth (Better Auth) ──
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# ── Social Login ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI (Multi-Provider Failover Chain) ──
# Layer 1: DeepSeek Official (primary — cheapest with cache discount)
DEEPSEEK_API_KEY=
# Layer 2: DeepInfra (backup — fast bare-metal inference)
DEEPINFRA_API_KEY=

# ── Email (Resend) ──
RESEND_API_KEY=

# job api
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# OpenWeb Ninja (JSearch job API — https://app.openwebninja.com)
OPENWEBNINJA_API_KEY=

APIFY_TOKEN=

# ── PostHog (Analytics + Error Tracking + Session Replay) ──
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Upstash (Redis cache + rate limiting) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Stripe (Billing) ──
# Get from Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Set by running: pnpm db:setup-stripe
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PRICE_ID=price_...
# Get from: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
